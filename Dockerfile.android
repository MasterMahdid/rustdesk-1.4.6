FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/25.2.9519653
ENV ANDROID_NDK=/opt/android-sdk/ndk/25.2.9519653
ENV VCPKG_ROOT=/opt/vcpkg
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=/opt/flutter/3.24.5/bin:/root/.cargo/bin:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    clang \
    cmake \
    curl \
    gcc-multilib \
    git \
    g++ \
    g++-multilib \
    libayatana-appindicator3-dev \
    libasound2-dev \
    libc6-dev \
    libclang-dev \
    libunwind-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgtk-3-dev \
    libpam0g-dev \
    libpulse-dev \
    libva-dev \
    libxcb-randr0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libxdo-dev \
    libxfixes-dev \
    llvm-dev \
    make \
    nasm \
    ninja-build \
    openjdk-17-jdk-headless \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    tree \
    unzip \
    wget \
    zip \
    libc6-i386 \
    lib32stdc++6 \
    lib32gcc-s1 \
    lib32ncurses6 \
    lib32z1 \
    autoconf \
    automake \
    libtool \
    && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y
RUN /root/.cargo/bin/rustup toolchain install 1.75
RUN /root/.cargo/bin/rustup default 1.75
RUN /root/.cargo/bin/rustup component add rustfmt

RUN mkdir -p /opt/android-sdk/cmdline-tools
RUN curl -o /tmp/cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip \
  && unzip /tmp/cmdline-tools.zip -d /opt/android-sdk/cmdline-tools \
  && rm /tmp/cmdline-tools.zip \
  && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest

RUN yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=${ANDROID_SDK_ROOT} --licenses
RUN /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=${ANDROID_SDK_ROOT} \
    "platform-tools" \
    "platforms;android-35" \
    "build-tools;35.0.1" \
    "cmdline-tools;latest" \
    "ndk;25.2.9519653"

RUN git clone --depth 1 --branch 3.24.5 https://github.com/flutter/flutter.git /opt/flutter/3.24.5
RUN chmod +x /opt/flutter/3.24.5/bin/flutter /opt/flutter/3.24.5/bin/cache/dart-sdk/bin/dart || true
RUN /opt/flutter/3.24.5/bin/flutter doctor -v || true

RUN git clone https://github.com/microsoft/vcpkg.git /opt/vcpkg
RUN cd /opt/vcpkg && git fetch --all --tags
RUN /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics
RUN chmod +x /opt/vcpkg/vcpkg

WORKDIR /workspace
COPY . /workspace
RUN chmod +x /workspace/flutter/*.sh

RUN set -e; \
    cd /workspace/flutter; \
    sed -i -e 's/extended_text: 14.0.0/extended_text: 13.0.0/g' pubspec.yaml || true; \
    /opt/flutter/3.24.5/bin/flutter pub get; \
    /root/.cargo/bin/cargo install cargo-expand --version 1.0.95 --locked; \
    /root/.cargo/bin/cargo install flutter_rust_bridge_codegen --version 1.80.1 --features "uuid" --locked; \
    /root/.cargo/bin/flutter_rust_bridge_codegen --rust-input ./../src/flutter_ffi.rs --dart-output ./lib/generated_bridge.dart --c-output ./macos/Runner/bridge_generated.h; \
    cp ./macos/Runner/bridge_generated.h ./ios/Runner/bridge_generated.h

RUN set -e; \
    cd /workspace; \
    export ANDROID_NDK_HOME=${ANDROID_NDK_HOME}; \
    export ANDROID_NDK=${ANDROID_NDK_HOME}; \
    export VCPKG_ROOT=${VCPKG_ROOT}; \
    for ABI in armeabi-v7a; do \
      ./flutter/build_android_deps.sh ${ABI}; \
    done

RUN set -e; \
    cd /workspace; \
    export ANDROID_NDK_HOME=${ANDROID_NDK_HOME}; \
    export ANDROID_NDK_ROOT=${ANDROID_NDK_HOME}; \
    export ANDROID_NDK=${ANDROID_NDK_HOME}; \
    /root/.cargo/bin/rustup target add armv7-linux-androideabi; \
    /root/.cargo/bin/cargo install cargo-ndk --version 3.1.2 --locked; \
    ./flutter/ndk_arm.sh; \
    mkdir -p ./flutter/android/app/src/main/jniLibs/armeabi-v7a; \
    cp ./target/armv7-linux-androideabi/release/liblibrustdesk.so ./flutter/android/app/src/main/jniLibs/armeabi-v7a/librustdesk.so

RUN set -e; \
    cd /workspace; \
    if [ -f /workspace/.github/patches/flutter_3.24.4_dropdown_menu_enableFilter.diff ]; then \
      cd /opt/flutter/3.24.5 && git apply /workspace/.github/patches/flutter_3.24.4_dropdown_menu_enableFilter.diff; \
      cd /workspace; \
    fi; \
    cd /workspace/flutter; \
    sed -i "s/org.gradle.jvmargs=-Xmx1024M/org.gradle.jvmargs=-Xmx2g/g" android/gradle.properties; \
    sed -i "s/signingConfigs.release/signingConfigs.debug/g" android/app/build.gradle; \
    mkdir -p android/app/src/main/jniLibs/armeabi-v7a; \
    cp ${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/arm-linux-androideabi/libc++_shared.so android/app/src/main/jniLibs/armeabi-v7a/; \
    /opt/flutter/3.24.5/bin/flutter build apk --release --target-platform android-arm; \
    mv build/app/outputs/flutter-apk/app-release.apk /workspace/rustdesk-1.4.6-armeabi-v7a.apk

CMD ["/bin/bash"]
