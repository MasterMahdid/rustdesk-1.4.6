FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# -------------------------
# Versions (from YAML)
# -------------------------
ENV RUST_VERSION=1.75
ENV FLUTTER_VERSION=3.22.3
ENV CARGO_EXPAND_VERSION=1.0.95
ENV FLUTTER_RUST_BRIDGE_VERSION=1.80.1

ENV PATH=/root/.cargo/bin:/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:$PATH

WORKDIR /workspace

# -------------------------
# Install system deps
# -------------------------
RUN apt-get update && apt-get install -y \
    ca-certificates \
    clang \
    cmake \
    curl \
    gcc \
    g++ \
    git \
    libclang-dev \
    libgtk-3-dev \
    llvm-dev \
    nasm \
    ninja-build \
    pkg-config \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# -------------------------
# Install Rust
# -------------------------
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain none
RUN rustup toolchain install $RUST_VERSION \
    --target x86_64-unknown-linux-gnu \
    --component rustfmt \
    --profile minimal \
    --no-self-update


# -------------------------
# Install Flutter
# -------------------------
RUN git clone https://github.com/flutter/flutter.git /opt/flutter \
    && cd /opt/flutter \
    && git checkout $FLUTTER_VERSION

# -------------------------
# Copy project
# -------------------------
COPY . /workspace

# -------------------------
# Install bridge tools + deps
# -------------------------
RUN cargo install cargo-expand --version $CARGO_EXPAND_VERSION --locked && \
    cargo install flutter_rust_bridge_codegen --version $FLUTTER_RUST_BRIDGE_VERSION --features "uuid" --locked

# -------------------------
# Flutter setup + patch
# -------------------------
RUN cd flutter && \
    sed -i -e 's/extended_text: 14.0.0/extended_text: 13.0.0/g' pubspec.yaml && \
    flutter pub get

# -------------------------
# Generate bridge
# -------------------------
RUN flutter_rust_bridge_codegen \
    --rust-input ./src/flutter_ffi.rs \
    --dart-output ./flutter/lib/generated_bridge.dart \
    --c-output ./flutter/macos/Runner/bridge_generated.h && \
    cp ./flutter/macos/Runner/bridge_generated.h ./flutter/ios/Runner/bridge_generated.h

# -------------------------
# Default output
# -------------------------
CMD ["bash", "-c", "ls -R src flutter/lib flutter/macos/Runner flutter/ios/Runner"]